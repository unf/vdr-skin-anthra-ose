<?xml version="1.0"?>
<skin version="1.2" name="anthra_OSE" screenBase="abs1920x1080">
<options>
	<option name="ChannelLogos" type="choice" values="left,right,none" default="left" title="Channel logos"/>
	<option name="LogoPath" type="string" default="/var/lib/vdr/channellogos" title="Path of the channel logos"/>
	<option name="SeparatorLogos" type="choice" values="left,right,none" default="left" title="Separator logos"/>
	<option name="SeparatorLogoPath" type="string" default="../liquid-logos4separator" title="Path of the separator logos"/>
	<option name="MenuLogos" type="bool" default="1" title="Main menu logos"/>
	<option name="MenuFont" type="choice" values="default,small,large" default="default" title="Main menu font"/>
	<option name="MenuGroups" type="choice" values="center,left" default="center" title="Group lines in menus"/>
	<option name="TimerInfo" type="bool" default="1" title="Timer info in the main menu"/>
	<option name="EpgImages" type="bool" default="1" title="EPG images (scraper)"/>
	<option name="RecordingImages" type="bool" default="1" title="Recording images (scraper)"/>
	<option name="Signal" type="choice" values="graph,digit" default="graph" title="Signal display"/>
</options>
	
